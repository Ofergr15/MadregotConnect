// Copy to Secrets.xcconfig (git-ignored) and fill in locally. Never commit real values.
// Use a NON-production Supabase project while the academy pilot is running.

MADREGOT_API_BASE_URL = http:/$()/localhost:3000
SUPABASE_URL = https:/$()/YOUR-DEV-PROJECT.supabase.co
SUPABASE_ANON_KEY = your-dev-anon-key

// On a real iPhone on the same Wi-Fi: point DEBUG builds at the Mac's Bonjour name
// (run `scutil --get LocalHostName`) and start the server with `npm run dev -- -H 0.0.0.0`.
// The [config=Debug] scope keeps a LAN address out of Release/TestFlight archives.
// MADREGOT_API_BASE_URL[config=Debug] = http:/$()/YOUR-MAC.local:3000
