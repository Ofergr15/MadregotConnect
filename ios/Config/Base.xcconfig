// Shared build settings for the Madregot app target.
//
// Debug builds default to the local Next.js dev server, never to production.
// To point a local build somewhere else, create ios/Config/Secrets.xcconfig
// (git-ignored; copy Secrets.example.xcconfig) and override the values there.
// Note: "//" starts a comment in xcconfig files, hence the "$()" in URLs.

MADREGOT_API_BASE_URL = http:/$()/localhost:3000
// The U21 Personal Coach flow (web /u21). Release defaults to the API host. Debug opens the
// u21-personal-coach branch alias: a Vercel-protected preview, so the in-app browser shows
// Vercel's own sign-in. No protection-bypass secret is ever put in the app.
MADREGOT_U21_URL = $(MADREGOT_API_BASE_URL)/u21
MADREGOT_U21_URL[config=Debug] = https:/$()/madregot-connect-git-u21-personal-coach-st-d1c4461c.vercel.app/u21
SUPABASE_URL =
SUPABASE_ANON_KEY =

// Cleartext http to a local/LAN dev server (ATS NSAllowsLocalNetworking) is allowed in
// DEBUG builds only: Info.plist is preprocessed and the key sits in #if MC_LOCAL_NETWORKING.
// Release/TestFlight builds get no ATS exception.
INFOPLIST_PREPROCESS = YES
INFOPLIST_PREPROCESSOR_DEFINITIONS[config=Debug] = MC_LOCAL_NETWORKING=1

#include? "Secrets.xcconfig"

// Demo mode (made-up data) stays available in TestFlight builds until the app has a
// non-production backend. Remove DEMO before any App Store release.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEMO
