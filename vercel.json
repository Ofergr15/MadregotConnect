{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "*/5 2-21 * * *"
    },
    {
      "path": "/api/cron/badges",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/academy-report",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/tick",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/workout-watch",
      "schedule": "*/15 3-10 * * *"
    }
  ]
}
