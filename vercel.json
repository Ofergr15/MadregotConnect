{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/academy-report",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/tick",
      "schedule": "0 * * * *"
    }
  ]
}
