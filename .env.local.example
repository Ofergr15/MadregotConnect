# MadregotConnect environment template.
#
#   cp .env.local.example .env.local
#
# Grouped by the feature each block unlocks. Only the "core" block is needed to
# boot the app; every later block degrades gracefully when left blank — the
# feature it powers is what breaks, not the build. The failure mode is noted per
# block so a missing value is diagnosable instead of mysterious.
#
# Never commit .env.local. Placeholder values only in THIS file.

# ─── Core — required, the app will not work without these ─────────────────────

# Supabase project URL and keys (Supabase dashboard → Settings → API).
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS: it is server-only, never expose it to
# the browser. Every API route authorises itself; there is no middleware.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key (console.anthropic.com) — parses pasted training plans and plan
# images into structured workouts. Plan parsing 500s without it.
ANTHROPIC_API_KEY=

# Public origin. Used to build absolute links in push notifications and emails,
# and as the Strava OAuth base. Set to the real https:// origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Product analytics and session replay (PostHog) ──────────────────────────

# Optional. Find the project token and ingestion host in PostHog project settings.
# When the token is blank, analytics is disabled. Form inputs are masked in all
# session recordings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# REQUIRED. Encrypts athletes.garmin_auth and athletes.strava_auth at rest
# (src/lib/encryption.ts), and signs the httpOnly device cookie that
# /api/auth/silent-session requires (src/lib/auth/device-token.ts — no separate
# secret to configure; with the key absent that route fails closed and athletes
# whose Supabase session lapsed have to log in again instead of self-healing).
# Must be exactly 32 bytes as 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Connecting Garmin fails with "ENCRYPTION_KEY environment variable is not set"
# when this is missing — the credentials are fine, the token encryption is what
# throws.
#
# WARNING: this key is not rotatable in place. Every stored garmin_auth /
# strava_auth blob can only be decrypted by the key that wrote it, so pointing a
# new key at a database that already holds connections makes those connections
# permanently unreadable. Generate a fresh key ONLY for an empty/dev database;
# for any environment sharing production's data, copy production's existing value.
ENCRYPTION_KEY=

# ─── Admin login ──────────────────────────────────────────────────────────────

# Shared password for the /admin login form. Without it the route returns 500
# "Admin login not configured" — the form looks broken rather than rejecting you.
# The email is only used as the from/notify address and defaults to
# madregot.club@gmail.com when blank.
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ─── Scheduled jobs (Vercel Cron) ─────────────────────────────────────────────

# Shared secret protecting the cron routes (/api/cron/*). Set the same value in
# Vercel → Settings → Environment Variables; Vercel Cron automatically sends it
# as "Authorization: Bearer <CRON_SECRET>". Left blank, the routes accept
# unauthenticated calls — fine locally, not in production.
#
# /api/cron/sync polls Garmin every 5 min and self-gates to 05:00-23:00 Israel
# time; the vercel.json schedule is deliberately an hour wider on each side
# because Vercel crons fire on fixed UTC while Israel shifts UTC+2/+3.
CRON_SECRET=

# ─── Web push notifications ───────────────────────────────────────────────────

# Generate a matched pair with:  npx web-push generate-vapid-keys
# Both must be present or sending silently no-ops (src/lib/push.ts returns false
# from ensureConfigured — no error, notifications just never arrive).
# VAPID_SUBJECT defaults to mailto:admin@madregot.club when blank.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Transactional email (Resend) ─────────────────────────────────────────────

# Optional. src/lib/email.ts checks RESEND_API_KEY and skips sending when unset,
# so invites and reports are silently not emailed. RESEND_FROM_EMAIL defaults to
# "Madregot <onboarding@resend.dev>", which only delivers to your own address
# until you verify a domain with Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Madregot <onboarding@resend.dev>

# ─── Strava (optional second data source) ─────────────────────────────────────

# The club runs on Garmin; the scheduled Strava poll was removed on 2026-08-28.
# These are only needed to onboard a Strava athlete or re-enable the webhook.
# STRAVA_REDIRECT_URI must match the callback configured in the Strava app.
# STRAVA_WEBHOOK_VERIFY_TOKEN is any string you choose — Strava echoes it back
# during subscription handshake and /api/strava/webhook compares the two.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=

# ─── Run chat (Stream) ────────────────────────────────────────────────────────

# Optional. getStreamServerClient() throws
# "STREAM_API_KEY / STREAM_API_SECRET not configured" when either is missing, so
# chat endpoints 500 while the rest of the app is unaffected.
STREAM_API_KEY=
STREAM_API_SECRET=

# ─── Club photos: Google Drive import + face tagging (optional) ───────────────

# Service account with read access to the shared photo folder. Paste the private
# key as a single line with literal \n escapes — client.ts converts them back
# (.replace(/\\n/g, '\n')), so a real multi-line value breaks .env parsing.
# Missing values throw "Missing GOOGLE_SERVICE_ACCOUNT_EMAIL or
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY" on any Drive import.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=

# AWS Rekognition, used to match runners' faces in imported photos.
# AWS_REGION defaults to us-east-1 and REKOGNITION_COLLECTION_ID to
# madregot-runners; the two credentials have no default and face indexing fails
# without them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
REKOGNITION_COLLECTION_ID=madregot-runners
